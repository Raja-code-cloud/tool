{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-content-hub.dev/schemas/evaluation-suite.schema.json",
  "title": "Prompt Evaluation Suite",
  "description": "A collection of evaluation cases for a prompt package",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_id", "prompt_version", "cases"],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string"
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "Minimum weighted pass rate (1.0 = all cases must pass)"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://cloud-content-hub.dev/schemas/evaluation-case.schema.json"
      }
    }
  }
}
