# Cloud Content Hub AI — Frontend environment variables
# Copy to `.env.local` for local development. Never commit secrets.
# Validated at build/runtime by `lib/config/env.ts`.

# Logical application environment exposed to the browser.
# Used for environment-aware UI behavior and logging context.
# Required: No (defaults to `development` when unset)
# Allowed values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Base URL for future HTTP repository adapters.
# When unset, the frontend uses in-memory mock repositories only.
# Required: No
# Example (local backend): http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Workspace scope header for tenant-isolated API calls (required for AI Studio).
# NEXT_PUBLIC_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Optional AI Studio defaults when content/model cannot be inferred from list endpoints.
# NEXT_PUBLIC_AI_CONTENT_ID=00000000-0000-4000-8000-000000000010
# NEXT_PUBLIC_AI_MODEL_ID=00000000-0000-4000-8000-000000000020
