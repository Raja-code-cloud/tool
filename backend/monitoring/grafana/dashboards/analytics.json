{
  "uid": "cch-analytics",
  "title": "Cloud Content Hub — Analytics (SLI Overview)",
  "tags": ["cch", "analytics", "slo", "sre"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API Availability",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "cch:api_availability:ratio5m" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 2,
      "title": "API Latency p95",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "cch:api_latency:p95_5m" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Worker Success",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "cch:worker_success:ratio5m" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "Publish Success",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "cch:publish_success:ratio5m" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 5,
      "title": "AI Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "cch:ai_errors:rate5m", "legendFormat": "ai errors/s" }]
    },
    {
      "id": 6,
      "title": "SLO Burn — Availability",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "cch:slo_availability:burn_rate_1h", "legendFormat": "burn" }]
    }
  ]
}
