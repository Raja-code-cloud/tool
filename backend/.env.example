CCH_ENVIRONMENT=local
CCH_SERVICE_NAME=cloud-content-hub
CCH_SERVICE_VERSION=0.1.0
CCH_LOG_LEVEL=INFO
CCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloud_content_hub
CCH_DATABASE_POOL_SIZE=5
CCH_DATABASE_TIMEOUT_SECONDS=5
CCH_REDIS_URL=redis://localhost:6379/0
CCH_REDIS_TIMEOUT_SECONDS=2
CCH_HTTP_ALLOWED_ORIGINS=["http://localhost:3000"]
CCH_HTTP_COMPRESSION_MINIMUM_SIZE=1000
CCH_OPENAPI_ENABLED=true
CCH_AZURE_STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
CCH_AZURE_STORAGE_CREDENTIAL_MODE=managed_identity
CCH_AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=
CCH_AZURE_STORAGE_AUTO_CREATE_CONTAINERS=false
CCH_AZURE_STORAGE_MAX_SIZE_BYTES=104857600
CCH_AZURE_STORAGE_UPLOAD_CHUNK_SIZE_BYTES=4194304
CCH_AZURE_STORAGE_DOWNLOAD_CHUNK_SIZE_BYTES=4194304
CCH_AZURE_STORAGE_TIMEOUT_SECONDS=30
CCH_AZURE_STORAGE_RETRY_TOTAL=3
